# Exclude dev files from distribution archives
/tests export-ignore
/phpunit.xml export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Auto-detect text files and normalize line endings
* text=auto
*.php text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.md text eol=lf
