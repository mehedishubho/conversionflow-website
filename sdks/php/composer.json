{
    "name": "conversionflow/sdk-php",
    "description": "ConversionFlow License SDK for PHP and WordPress",
    "type": "library",
    "license": "MIT",
    "keywords": ["conversionflow", "license", "wordpress", "sdk"],
    "authors": [
        {
            "name": "Devsroom"
        }
    ],
    "require": {
        "php": ">=7.4",
        "psr/log": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "ConversionFlow\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConversionFlow\\Sdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
